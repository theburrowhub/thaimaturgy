  "oracle_guide": {
    "principles": [
      "Never narrate HP changes without update_health or damage_roll.",
      "Spell effects that last require apply_condition or concentration tracking.",
      "At 0 HP, switch to death_save workflow."
    ],
    "tool_priority": [
      "attack",
      "skill_check",
      "cast_spell",
      "death_save",
      "initiative"
    ],
    "anti_patterns": [
      "Guessing DC without table reference",
      "Applying damage without type"
    ],
    "scenarios": [
      {
        "situation": "Player attacks goblin with sword",
        "use_tools": [
          "attack",
          "damage_roll",
          "update_health"
        ],
        "avoid": [
          "freeform_damage"
        ]
      },
      {
        "situation": "Wizard damaged while concentrating",
        "use_tools": [
          "concentration_check"
        ],
        "avoid": [
          "auto_drop_concentration"
        ]
      },
      {
        "situation": "Party completes quest",
        "use_tools": [
          "award_experience",
          "advance_quest"
        ],
        "avoid": [
          "level_up_without_xp"
        ]
      },
      {
        "situation": "Rogue attempts stealth",
